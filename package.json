{
  "name": "prime-desk",
  "version": "0.2.0",
  "private": true,
  "description": "Interface gráfica desktop para o prime-agent",
  "author": {
    "name": "Matheus Carvalho",
    "email": "prime-desk@localhost"
  },
  "homepage": "https://github.com/PrimeIntellect-ai/prime-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/matheus/prime-desk.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --linux deb AppImage",
    "dev:nosandbox": "PRIME_DESK_NO_SANDBOX=1 electron-vite dev",
    "start:nosandbox": "PRIME_DESK_NO_SANDBOX=1 electron-vite preview",
    "fix-sandbox": "sudo chown root:root node_modules/electron/dist/chrome-sandbox && sudo chmod 4755 node_modules/electron/dist/chrome-sandbox",
    "icon": "electron scripts/make-icon.mjs",
    "dist:linux": "electron-vite build && electron-builder --linux deb AppImage",
    "dist:mac": "electron-vite build && electron-builder --mac zip --x64 --arm64",
    "dist:mac:dmg": "electron-vite build && electron-builder --mac dmg zip --x64 --arm64",
    "dist:all": "npm run dist:linux && npm run dist:mac",
    "desktop:install": "node scripts/install-desktop.mjs",
    "desktop:remove": "node scripts/install-desktop.mjs --remove"
  },
  "//overrides": "@electron/rebuild traz node-gyp 9, cujo gyp ainda faz `from distutils.version import StrictVersion` — módulo removido no Python 3.12. Em máquina com Python novo o build do node-pty falha antes de compilar. O node-gyp 11 usa gyp-next, que não depende de distutils.",
  "overrides": {
    "node-gyp": "^11.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^11.15.0",
    "highlight.js": "^11.10.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.2"
  }
}
